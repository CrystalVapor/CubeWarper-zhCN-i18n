  "narrative_files": [
    {
      "path": "kubejs/assets/kubejs/textures/exploration_team_1/day_12.txt",
      "backup": "localization/backups/functions/kubejs/assets/kubejs/textures/exploration_team_1/day_12.txt",
      "original_sha256": "2435413d0029af9f3f91ec2e6c18848247f8dbecca196b8db3a4ad01a94a7463",
      "localized_sha256": "b8561ca9cc446f717513780c57d1a412f4cc4390be0bf2cc2e4a28c2a7bd50ac",
      "dialogue_turns": 13,
      "translations": [
        {
          "line": 1,
          "english": "/  So what is going on with those eyes?",
          "chinese": "/  那些眼睛是怎么回事？"
        },
        {
          "line": 3,
          "english": "// The pillars you mean?",
          "chinese": "// 你是指那些柱子吗？"
        },
        {
          "line": 5,
          "english": "/  Yes.",
          "chinese": "/  是的。"
        },
        {
          "line": 7,
          "english": "// Well what happens to your memory of a place if you haven't been there a long time?",
          "chinese": "// 如果你很久没有去过一个地方，对那里的记忆会有什么变化？"
        },
        {
          "line": 9,
          "english": "/  It fades?",
          "chinese": "/  会逐渐淡忘？"
        },
        {
          "line": 11,
          "english": "// Exactly.",
          "chinese": "// 正是如此。"
        },
        {
          "line": 13,
          "english": "// Now what if I would tell you that given enough time that idea can be applied to not just memories?",
          "chinese": "// 如果我告诉你，只要时间足够久，这个规律也会作用于记忆以外的事物呢？"
        },
        {
          "line": 15,
          "english": "/  I don't think I follow.",
          "chinese": "/  我好像没听明白。"
        },
        {
          "line": 17,
          "english": "// Its exactly like I said, if something is not observed for a long period of time in these dimensions it will simply stop existing.",
          "chinese": "// 就像我说的，在这些维度里，如果某个事物长时间没有被观察，它就会直接消失。"
        },
        {
          "line": 19,
          "english": "/  Like a fading memory?, that sounds completely insane.",
          "chinese": "/  就像逐渐淡忘的记忆？这听起来太疯狂了。"
        },
        {
          "line": 21,
          "english": "// Yes, like a fading memory and most good revelations do indeed sound insane at first.",
          "chinese": "// 是的，就像逐渐淡忘的记忆。大多数重要发现刚提出时，确实都听起来很疯狂。"
        },
        {
          "line": 23,
          "english": "/  You still haven't answered my question.",
          "chinese": "/  你还是没有回答我的问题。"
        },
        {
          "line": 25,
          "english": "// I'm pretty sure I just did.",
          "chinese": "// 我很确定，我刚才已经回答了。"
        }
      ]
    }
  ],
